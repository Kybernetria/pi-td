{
  "protocolVersion": "0.2.0",
  "nodeId": "pi_please",
  "packageId": "pi-please",
  "version": "0.1.0",
  "purpose": "File-based todo management: create, list, get, update, delete, claim, and release todo items stored as markdown files under .pi/todos.",
  "provides": [
    {
      "name": "list",
      "description": "List todos. By default returns open and assigned todos; set include_closed to true to include closed todos too.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "include_closed": {
            "type": "boolean",
            "description": "If true, include closed todos in the response"
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "assigned": { "type": "array", "items": { "type": "object" } },
          "open": { "type": "array", "items": { "type": "object" } },
          "closed": { "type": "array", "items": { "type": "object" } },
          "error": { "type": "string" }
        }
      },
      "execution": { "type": "handler", "handler": "list" }
    },
    {
      "name": "get",
      "description": "Get a single todo by id (TODO-<hex> or raw hex). Returns the full todo record with body.",
      "inputSchema": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "description": "Todo id (TODO-<hex> or raw hex)" }
        }
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } },
          "status": { "type": "string" },
          "created_at": { "type": "string" },
          "assigned_to_session": { "type": "string" },
          "body": { "type": "string" },
          "error": { "type": "string" }
        }
      },
      "execution": { "type": "handler", "handler": "get" }
    },
    {
      "name": "create",
      "description": "Create a new todo with title, optional tags, status, and body. Returns the created todo.",
      "inputSchema": {
        "type": "object",
        "required": ["title"],
        "properties": {
          "title": { "type": "string", "description": "Short summary of the todo" },
          "tags": { "type": "array", "items": { "type": "string" }, "description": "Optional tags" },
          "status": { "type": "string", "description": "Optional status (default: open)" },
          "body": { "type": "string", "description": "Long-form markdown details" }
        }
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } },
          "status": { "type": "string" },
          "created_at": { "type": "string" },
          "assigned_to_session": { "type": "string" },
          "body": { "type": "string" },
          "error": { "type": "string" }
        }
      },
      "execution": { "type": "handler", "handler": "create" }
    },
    {
      "name": "update",
      "description": "Update an existing todo's title, status, tags, or body. Use status=closed/open for close/reopen. Use body_mode=append to append body text instead of replacing it.",
      "inputSchema": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "description": "Todo id (TODO-<hex> or raw hex)" },
          "title": { "type": "string", "description": "New title" },
          "status": { "type": "string", "description": "New status, e.g. open or closed" },
          "tags": { "type": "array", "items": { "type": "string" }, "description": "New tags" },
          "body": { "type": "string", "description": "Body text to replace or append" },
          "body_mode": { "type": "string", "enum": ["replace", "append"], "description": "Body update mode. Defaults to replace." }
        }
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } },
          "status": { "type": "string" },
          "created_at": { "type": "string" },
          "assigned_to_session": { "type": "string" },
          "body": { "type": "string" },
          "error": { "type": "string" }
        }
      },
      "execution": { "type": "handler", "handler": "update" }
    },
    {
      "name": "delete",
      "description": "Delete a todo by id. Returns the deleted todo record.",
      "inputSchema": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "description": "Todo id (TODO-<hex> or raw hex)" }
        }
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } },
          "status": { "type": "string" },
          "created_at": { "type": "string" },
          "assigned_to_session": { "type": "string" },
          "body": { "type": "string" },
          "error": { "type": "string" }
        }
      },
      "execution": { "type": "handler", "handler": "delete" }
    },
    {
      "name": "claim",
      "description": "Claim assignment of a todo for the calling session. Returns the updated todo.",
      "inputSchema": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "description": "Todo id (TODO-<hex> or raw hex)" },
          "force": { "type": "boolean", "description": "Override another session's assignment" }
        }
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } },
          "status": { "type": "string" },
          "created_at": { "type": "string" },
          "assigned_to_session": { "type": "string" },
          "body": { "type": "string" },
          "error": { "type": "string" }
        }
      },
      "execution": { "type": "handler", "handler": "claim" }
    },
    {
      "name": "release",
      "description": "Release session assignment of a todo. Returns the updated todo.",
      "inputSchema": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "description": "Todo id (TODO-<hex> or raw hex)" },
          "force": { "type": "boolean", "description": "Override another session's assignment" }
        }
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } },
          "status": { "type": "string" },
          "created_at": { "type": "string" },
          "assigned_to_session": { "type": "string" },
          "body": { "type": "string" },
          "error": { "type": "string" }
        }
      },
      "execution": { "type": "handler", "handler": "release" }
    }
  ]
}
