{
  "name": "pi-todo",
  "version": "0.1.0",
  "type": "module",
  "description": "File-based todo management via pi-protocol: create, list, update, close, and delete todo items stored as markdown files.",
  "keywords": [
    "pi-package",
    "pi-protocol",
    "todos",
    "task-management"
  ],
  "exports": "./extension.ts",
  "scripts": {
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "protocol:check": "pi-protocol check .",
    "protocol:generate": "pi-protocol generate ."
  },
  "pi": {
    "extensions": [
      "./extension.ts"
    ]
  },
  "piProtocol": {
    "generated": "protocol.generated.ts"
  },
  "dependencies": {
    "@earendil-works/pi-tui": "^0.80.6",
    "@kybernetria/pi-protocol": "https://github.com/Kybernetria/pi-protocol/releases/download/v4.0.0/kybernetria-pi-protocol-4.0.0.tgz",
    "typebox": "^1.3.6"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.80.6",
    "@types/node": "^24.5.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
