{
  "name": "pi-todo",
  "version": "0.1.0",
  "type": "module",
  "description": "File-based todo management via pi-protocol: create, list, update, close, and delete todo items stored as markdown files.",
  "keywords": [
    "pi-package",
    "pi-protocol",
    "todos",
    "task-management"
  ],
  "exports": "./extension.ts",
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "pi": {
    "extensions": [
      "./extension.ts"
    ]
  },
  "dependencies": {
    "@earendil-works/pi-tui": "^0.80.6",
    "@kybernetria/pi-protocol": "1.0.4",
    "typebox": "^1.3.6"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.80.6",
    "@types/node": "^24.5.2",
    "typescript": "^5.9.3"
  }
}
